SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,.railway.app,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.railway.app,https://yourdomain.com

# ── Local dev ────────────────────────────────────────────
DB_NAME=quest_dnc
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

# ── Production (Railway auto-injects these) ──────────────
# Railway PostgreSQL plugin sets DATABASE_URL automatically.
# Railway Redis plugin sets REDIS_URL automatically.
# You only need to set the vars below manually.

# ── Email (leave EMAIL_BACKEND as console for local dev) ──
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production, use Brevo SMTP (https://app.brevo.com → Settings → SMTP & API):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=8xxxxx001@smtp-brevo.com
EMAIL_HOST_PASSWORD=xsmtpsib-your-brevo-smtp-key
DEFAULT_FROM_EMAIL=noreply@checkdnc.net

# ── DNC API ──────────────────────────────────────────────
DNC_API_KEY=your-dnc-api-key-here
# Number of concurrent API requests per batch (default 50)
# DNC_API_CONCURRENCY=50

# ── AWS S3 media storage (leave unset to use local media/ folder) ──
# When set, uploaded files and result CSVs are stored in S3 instead of disk.
AWS_STORAGE_BUCKET_NAME=aws-s3-demo-bucket-check-dnc
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_REGION_NAME=us-west-2

# ── AppSumo Licensing (Partner Portal → Redemption) ──────
# client_id/client_secret appear in the portal after your URLs validate.
# APPSUMO_API_KEY is the "private key" shown on the Redemption page
# (replaced with the final key when the listing is submitted).
APPSUMO_CLIENT_ID=
APPSUMO_CLIENT_SECRET=
APPSUMO_API_KEY=
# Credits granted per AppSumo tier (tier:credits, comma-separated)
APPSUMO_TIER_CREDITS=1:100000,2:250000,3:1000000
